{
  "name": "node-red-palettes",
  "version": "0.0.1",
  "description": "A Node-Red Palette Template.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "url": "https://github.com/TXC/node-red-palettes",
    "type": "git"
  },
  "author": {
    "name": "TXC",
    "email": "txc@txc.se"
  },
  "files": [
    "dist/",
    "examples/"
  ],
  "main": "dist/nodes/palette-demo/palette-demo.js",
  "types": "dist/nodes/palette-demo/palette-demo.d.ts",
  "packageManager": "pnpm@12.14.0",
  "node-red": {
    "version": ">=1.0.0",
    "nodes": {
      "palette-demo": "./dist/nodes/palette-demo/palette-demo.js"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.11.0"
  },
  "keywords": [
    "node-red",
    "palette",
    "demo"
  ],
  "scripts": {
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "build:dev": "vite build --mode development",
    "debug": "NODE_OPTIONS='--inspect-brk' NODE_ENV=development vite",
    "dev": "vite",
    "check": "pnpm run lint && pnpm run format",
    "format": "prettier --check \"src/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "format:fix": "prettier --write \"src/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "lint": "eslint --cache \"src/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "lint:fix": "eslint --cache --fix \"src/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "package": "pnpm build && pnpm pack",
    "release": "pnpm exec semantic-release",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.6",
    "@types/node-red": "^1.3.5",
    "@types/node-red-node-test-helper": "^0.3.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@txcswe/vite-plugin-node-red-node": "^1.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "node-red": "^5.0.9",
    "node-red-node-test-helper": "^0.3.6",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}

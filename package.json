{
  "name": "node-red-palettes",
  "version": "0.0.1",
  "description": "A Node-Red Palette Template.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "url": "https://github.com/TXC/node-red-palettes",
    "type": "git"
  },
  "author": {
    "name": "TXC",
    "email": "txc@txc.se"
  },
  "files": [
    "dist/",
    "examples/"
  ],
  "main": "dist/nodes/palette-demo/palette-demo.js",
  "types": "dist/nodes/palette-demo/palette-demo.d.ts",
  "packageManager": "pnpm@12.14.0",
  "node-red": {
    "version": ">=1.0.0",
    "nodes": {
      "palette-demo": "./dist/nodes/palette-demo/palette-demo.js"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.11.0"
  },
  "keywords": [
    "node-red",
    "palette",
    "demo"
  ],
  "scripts": {
    "debug": "NODE_OPTIONS='--inspect-brk' NODE_ENV=development vite",
    "dev": "vite",
    "build:dev": "vite build --mode development",
    "build:debug": "vite build --mode debug",
    "build": "vite build",
    "package": "pnpm build && pnpm pack",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/node-red": "^1.3.5",
    "@types/node-red-node-test-helper": "^0.3.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "colorette": "^2.0.20",
    "concurrently": "^10.0.4",
    "copyfiles": "^2.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "moment": "^2.30.1",
    "mustache": "^4.2.0",
    "node-red": "^5.0.1",
    "node-red-node-test-helper": "^0.3.6",
    "nodemon": "^3.1.14",
    "onchange": "^7.1.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-node-red-node": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
